# ============================================================
# FRONTEND (VITE_* — client bundle ga kiradi, hamma ko'ra oladi)
# ============================================================

# Forma yuborish endpoint (o'z serveringiz bo'lsa):
VITE_CONTACT_ENDPOINT=/api/contact

# GitHub Pages yoki boshqa static hosting uchun base path:
VITE_BASE_PATH=/

# Cloudflare Turnstile (bot himoyasi) — ixtiyoriy:
VITE_TURNSTILE_SITE_KEY=

# Plausible analytics — ixtiyoriy:
VITE_PLAUSIBLE_DOMAIN=

# Google Analytics — ixtiyoriy:
VITE_GA_MEASUREMENT_ID=

# Telegram client-side fallback — faqat o'z serveri bo'lmagan static hostingda.
# DIQQAT: bu qiymatlar build qilingandan keyin JS faylda ko'rinadi.
# Faqat VITE_CONTACT_ENDPOINT ishlamasa ishlatiladi.
VITE_CLIENT_TELEGRAM_BOT_TOKEN=
VITE_CLIENT_TELEGRAM_CHAT_ID=

# ============================================================
# BACKEND (server/contact-core.mjs tomonida o'qiladi)
# ============================================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Ixtiyoriy — Resend orqali email fallback:
# RESEND_API_KEY=
# RESEND_FROM=noreply@yourdomain.com
# RESEND_TO=your@email.com

# Ixtiyoriy — CORS:
# CORS_ORIGIN=https://your-username.github.io

# Ixtiyoriy — Cloudflare Turnstile (server-side tekshiruv):
# TURNSTILE_SECRET_KEY=

# Ixtiyoriy — Rate limiting:
# CONTACT_RATE_LIMIT_ENABLED=true
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=60000

# Ixtiyoriy — Upstash Redis (distributed rate limiting):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Ixtiyoriy — monitoring webhook:
# CONTACT_MONITOR_WEBHOOK_URL=
